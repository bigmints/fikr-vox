{
  "name": "fikr-vox",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test",
    "desktop": "tauri dev",
    "build:desktop": "tauri build --bundles app",
    "test:rust": "node scripts/prepare-desktop.mjs && cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "prepare:licenses": "python3 scripts/generate-notices.py"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4"
  },
  "description": "An open-source Mac studio for voiceovers, podcasts, and video dubbing.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigmints/fikr-vox.git"
  },
  "homepage": "https://fikr.one/vox/",
  "bugs": {
    "url": "https://github.com/bigmints/fikr-vox/issues"
  }
}
